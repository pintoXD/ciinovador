VERSION 5.5 ;
NAMESCASESENSITIVE ON ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN multiplier32FP ;

SCANCHAINS 1 ;
  - top_chain_seg1_clk_rising 
    + PARTITION p_clk_rising_worst 
      MAXBITS 40
    + START PIN scan_in
    + FLOATING 
       current_state_reg[0] ( IN SI ) ( OUT Q ) 
       current_state_reg[1] ( IN SI ) ( OUT Q ) 
       current_state_reg[2] ( IN SI ) ( OUT Q ) 
       done_o_reg ( IN SI ) ( OUT Q ) 
       inifinit_o_reg ( IN SI ) ( OUT Q ) 
       nan_o_reg ( IN SI ) ( OUT Q ) 
       overflow_o_reg ( IN SI ) ( OUT Q ) 
       product_o_reg[0] ( IN SI ) ( OUT Q ) 
       product_o_reg[1] ( IN SI ) ( OUT Q ) 
       product_o_reg[2] ( IN SI ) ( OUT Q ) 
       product_o_reg[3] ( IN SI ) ( OUT Q ) 
       product_o_reg[4] ( IN SI ) ( OUT Q ) 
       product_o_reg[5] ( IN SI ) ( OUT Q ) 
       product_o_reg[6] ( IN SI ) ( OUT Q ) 
       product_o_reg[7] ( IN SI ) ( OUT Q ) 
       product_o_reg[8] ( IN SI ) ( OUT Q ) 
       product_o_reg[9] ( IN SI ) ( OUT Q ) 
       product_o_reg[10] ( IN SI ) ( OUT Q ) 
       product_o_reg[11] ( IN SI ) ( OUT Q ) 
       product_o_reg[12] ( IN SI ) ( OUT Q ) 
       product_o_reg[13] ( IN SI ) ( OUT Q ) 
       product_o_reg[14] ( IN SI ) ( OUT Q ) 
       product_o_reg[15] ( IN SI ) ( OUT Q ) 
       product_o_reg[16] ( IN SI ) ( OUT Q ) 
       product_o_reg[17] ( IN SI ) ( OUT Q ) 
       product_o_reg[18] ( IN SI ) ( OUT Q ) 
       product_o_reg[19] ( IN SI ) ( OUT Q ) 
       product_o_reg[20] ( IN SI ) ( OUT Q ) 
       product_o_reg[21] ( IN SI ) ( OUT Q ) 
       product_o_reg[22] ( IN SI ) ( OUT Q ) 
       product_o_reg[23] ( IN SI ) ( OUT Q ) 
       product_o_reg[24] ( IN SI ) ( OUT Q ) 
       product_o_reg[25] ( IN SI ) ( OUT Q ) 
       product_o_reg[26] ( IN SI ) ( OUT Q ) 
       product_o_reg[27] ( IN SI ) ( OUT Q ) 
       product_o_reg[28] ( IN SI ) ( OUT Q ) 
       product_o_reg[29] ( IN SI ) ( OUT Q ) 
       product_o_reg[30] ( IN SI ) ( OUT Q ) 
       product_o_reg[31] ( IN SI ) ( OUT Q ) 
       underflow_o_reg ( IN SI ) ( OUT Q ) 
    + STOP PIN scan_out
;

END SCANCHAINS 
END DESIGN 
